FROM tobix/pywine:3.12

WORKDIR /src

# Install pyinstaller
RUN wine pip install pyinstaller

# Copy source
COPY silence_remover.py .

# Download static ffmpeg for Windows
RUN apt-get update && apt-get install -y wget unzip && \
    wget -q https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip -O ffmpeg.zip && \
    unzip -q ffmpeg.zip && \
    mv ffmpeg-master-latest-win64-gpl/bin/ffmpeg.exe . && \
    mv ffmpeg-master-latest-win64-gpl/bin/ffprobe.exe . && \
    rm -rf ffmpeg.zip ffmpeg-master-latest-win64-gpl

# Build exe
RUN wine pyinstaller --onefile --name "SilenceRemover" \
    --add-binary "ffmpeg.exe;." \
    --add-binary "ffprobe.exe;." \
    silence_remover.py

# Output will be in /src/dist/SilenceRemover.exe
